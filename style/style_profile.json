{
  "id": "lwy-lecture-style",
  "name": "刘文印 TRIZ 讲课风格",
  "version": "1.0",
  "updated": "2026-11-01",
  "source": "本仓第 1-16 讲历次修改、提问与返工记录",
  "tone": {
    "person": "second",
    "address": "你",
    "register": "口语、直白、不用书面连接词",
    "connector_min_per_100_chars": 3,
    "connectors": ["所以", "但是", "因为", "比如", "说白了", "其实"],
    "forbidden": ["综上所述", "由此可见", "笔者", "本文认为"]
  },
  "structure": {
    "opening": "三个具体困境场景，第四句才给定义",
    "title_rule": "标题必须是判断句，不是名词短语",
    "one_point_per_slide": true,
    "max_points_per_slide": 6,
    "closing": "三句话可带走 + 下一讲预告 + 下一讲复用本讲产物"
  },
  "examples": {
    "min_cross_industry": 3,
    "industries": ["制造", "医疗", "软件", "物流", "农业"],
    "numbers": "必须给量级与前后对比",
    "disclaimer_required": "教学示例需标明，不得虚构实测数据"
  },
  "actionability": {
    "every_concept_must_name_object": "说清动的是哪个对象",
    "one_hypothesis_per_round": "一次只验证一条",
    "exercise_deliverables": ["方案", "改前改后各一个数", "上传 TRIZa"]
  },
  "visual": {
    "body_min_pt": 20,
    "exempt_pt": {"kicker": 14, "footer": 12, "pageno": 12, "cover_meta": 12, "figure_label": "14-18"},
    "max_lines_per_point": 2,
    "prefer_figure_over_text": true,
    "page_count": 12,
    "footer": "TRIZ 创新构思法实战研讨班  ·  第 N 次 Workshop"
  },
  "notes": {
    "chars_min": 3000,
    "chars_max": 3500,
    "chars_per_minute": 235,
    "minutes_target": 15
  },
  "anti_patterns": [
    "封面写五条正文写六条",
    "表格五行但框里列六条",
    "把原理名当答案",
    "一页塞三段并列内容",
    "讲稿写成论文摘要，没有你"
  ],
  "rules": [
    {"id": "R01", "cat": "tone", "rule": "第二人称直呼你，第一人称只用于示弱", "check": "统计讲稿中 你 的出现次数 ≥ 我们 的 2 倍"},
    {"id": "R02", "cat": "tone", "rule": "每 100 字至少 3 个口语连接词", "check": "connector_density >= 0.03"},
    {"id": "R03", "cat": "structure", "rule": "标题是判断句", "check": "标题含谓语或否定/转折，非纯名词"},
    {"id": "R04", "cat": "structure", "rule": "先困境后定义", "check": "页序 dilemma 在 define 之前"},
    {"id": "R05", "cat": "structure", "rule": "结尾三句话 + 下次预告", "check": "summary 页含 下次"},
    {"id": "R06", "cat": "examples", "rule": "至少三个跨行业例子", "check": "行业词覆盖 >= 3"},
    {"id": "R07", "cat": "examples", "rule": "数字给量级与前后对比", "check": "改前/改后 数值成对出现"},
    {"id": "R08", "cat": "actionability", "rule": "每个概念落到具体对象", "check": "存在 动的是/分割什么/抽取什么 类句式"},
    {"id": "R09", "cat": "actionability", "rule": "一次只验证一条", "check": "存在 挑一条/只验证一条 的护栏句"},
    {"id": "R10", "cat": "visual", "rule": "正文 >= 20pt，一页 <= 6 条", "check": "min_font >= 20 且 points <= 6"},
    {"id": "R11", "cat": "visual", "rule": "能画图就不写三段话", "check": "每讲至少 1 个 fig-* 图元"},
    {"id": "R12", "cat": "consistency", "rule": "全篇条数唯一自洽（封面/表格/框/讲稿同源）", "check": "同一量词数字在全篇只出现一种取值"},
    {"id": "R13", "cat": "notes", "rule": "讲稿 3000-3500 字，约 15 分钟", "check": "3000 <= chars <= 3500"},
    {"id": "R14", "cat": "integrity", "rule": "不编造实验数据与学生案例结果", "check": "示例标注为教学示例，无具体机构实测断言"}
  ]
}